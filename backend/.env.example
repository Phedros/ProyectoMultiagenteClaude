# ── OpenAI ────────────────────────────────────────────────────────────────────
# Models: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
OPENAI_API_KEY=sk-...

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
# Models: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022, claude-3-opus-20240229
ANTHROPIC_API_KEY=sk-ant-...

# ── Google Gemini ─────────────────────────────────────────────────────────────
# Models: gemini/gemini-2.0-flash, gemini/gemini-1.5-pro
GEMINI_API_KEY=AIza...

# ── Groq (fast inference, free tier) ─────────────────────────────────────────
# Models: groq/llama-3.1-70b-versatile, groq/mixtral-8x7b-32768
# Get key at: https://console.groq.com
GROQ_API_KEY=gsk_...

# ── Ollama (local, no key needed) ─────────────────────────────────────────────
# Install: https://ollama.ai  |  Run: ollama pull llama3
# Models prefix: ollama/llama3, ollama/mistral, ollama/codellama, ollama/phi3
